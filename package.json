{
  "name": "hackbuild-suite",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Moheeb Zara <hackbuildvideo@gmail.com>",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "build:all": "npm run build && npm run build:single",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "node --test tools/test/*.test.mjs",
    "smoke:file": "node tools/smoke-file.mjs",
    "smoke:models": "node tools/smoke-models.mjs",
    "ui:check": "node tools/vendor/pin-ui.mjs --check",
    "lint:voice": "git ls-files | grep -Ev '\\.(png|jpe?g|glb|bin|wasm|wav)$|^(LICENSES/|RULES.md|CLAUDE.md|tools/)|package-lock.json|Cargo.lock' | xargs node tools/lint-voice.mjs",
    "shots": "node tools/shots.mjs",
    "size": "node tools/check-size.mjs",
    "smoke:chat": "node tools/smoke-chat.mjs",
    "smoke:transcribe": "node tools/smoke-transcribe.mjs",
    "smoke:memory": "node tools/smoke-memory.mjs",
    "smoke:speak": "node tools/smoke-speak.mjs",
    "smoke:vision": "node tools/smoke-vision.mjs",
    "smoke:generate": "node tools/smoke-generate.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "puppeteer-core": "25.18.1",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vite-plugin-singlefile": "2.3.4",
    "vue-tsc": "2.2.12"
  },
  "description": "Browser AI and 3D character tools in one tab, built on the hackbuild libraries.",
  "dependencies": {
    "@hackbuild/ai-env": "file:tools/vendor/hackbuild-ai-env-0.1.0-a79f0f5.tgz",
    "@hackbuild/audio-dsp": "file:tools/vendor/hackbuild-audio-dsp-0.1.0-36e5ca9.tgz",
    "@hackbuild/chat": "file:tools/vendor/hackbuild-chat-0.1.0-a79f0f5.tgz",
    "@hackbuild/converse": "file:tools/vendor/hackbuild-converse-0.1.0-a79f0f5.tgz",
    "@hackbuild/devices": "file:tools/vendor/hackbuild-devices-0.1.0-a79f0f5.tgz",
    "@hackbuild/imagegen": "file:tools/vendor/hackbuild-imagegen-0.1.0-44da07c.tgz",
    "@hackbuild/media": "file:tools/vendor/hackbuild-media-0.1.0-2219635.tgz",
    "@hackbuild/memory": "file:tools/vendor/hackbuild-memory-0.1.0-a79f0f5.tgz",
    "@hackbuild/models": "file:tools/vendor/hackbuild-models-0.1.0-a79f0f5.tgz",
    "@hackbuild/speak": "file:tools/vendor/hackbuild-speak-0.1.0-44da07c.tgz",
    "@hackbuild/transcribe": "file:tools/vendor/hackbuild-transcribe-0.1.0-2219635.tgz",
    "@hackbuild/vision": "file:tools/vendor/hackbuild-vision-0.1.0-44da07c.tgz",
    "@hackbuild/weights": "file:tools/vendor/hackbuild-weights-0.1.0-a79f0f5.tgz",
    "@virgilvox/hackbuild-ui": "file:tools/vendor/hackbuild-ui-0.7.0-825837f.tgz",
    "vue": "3.5.41",
    "vue-router": "4.6.4"
  }
}
